{
  "name": "blog-x",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": { "node": ">=24.15.0" },
  "scripts": {
    "docker:retention": "node scripts/ops/docker-image-retention.mjs",
    "production:readiness": "node scripts/ops/production-readiness.mjs",
    "production:evidence:assemble": "node scripts/release-gate/assemble.mjs",
    "dev:api": "corepack pnpm --filter @blog-x/api dev",
    "dev:web": "corepack pnpm --filter @blog-x/web dev",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "node scripts/default-test.mjs",
    "test:integration": "node scripts/local-delivery-acceptance.mjs",
    "test:ops": "node --test scripts/local-verify.test.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "local:verify": "node scripts/local-verify.mjs",
    "local:deliver:preflight": "node scripts/refresh-local.mjs --check-docker-capacity",
    "local:deliver": "node scripts/refresh-local.mjs",
    "db:generate:check": "corepack pnpm --filter @blog-x/api db:generate:check",
    "db:migrate": "corepack pnpm --filter @blog-x/api db:migrate",
    "db:seed": "corepack pnpm --filter @blog-x/api db:seed",
    "db:schema:verify": "corepack pnpm --filter @blog-x/api db:schema:verify",
    "cleanup:views": "corepack pnpm --filter @blog-x/api cleanup:views",
    "retention": "corepack pnpm --filter @blog-x/api retention --views-limit=100 --sessions-limit=100",
    "ops:status": "node scripts/ops-status.mjs",
    "ops:monitor": "node scripts/ops-monitor.mjs",
    "maintenance:retention": "corepack pnpm --filter @blog-x/api retention --views-limit=100 --sessions-limit=100",
    "test:ops:phase17": "node scripts/ops/phase17-acceptance.mjs",
    "test:e2e": "corepack pnpm --filter @blog-x/web test:e2e",
    "test:e2e:auth": "corepack pnpm --filter @blog-x/web test:e2e:auth",
    "backup:hexo": "node scripts/backup/hexo-content.mjs",
    "test:backup:hexo": "node --test scripts/backup/hexo-content.test.mjs",
    "test:deploy:secondary": "node --test deploy/secondary/secondary.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "tsx": "4.23.7",
    "typescript": "7.0.2"
  }
}
