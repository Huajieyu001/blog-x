# The invoking refresh command always builds this target with --network=none --pull=false.
ARG SEED_IMAGE
FROM ${SEED_IMAGE} AS seed-store

COPY scripts/refresh-seed-store.mjs /usr/local/lib/refresh-seed-store.mjs
RUN node /usr/local/lib/refresh-seed-store.mjs

# Start each target from a stable runtime instead of inheriting the previous
# target image. Only the verified offline store crosses the stage boundary, so
# repeated refreshes do not retain old workspaces in immutable parent layers.
FROM node:24.15.0-alpine AS runtime

ARG REFRESH_REVISION
ARG LOCKFILE_SHA256
ARG SEED_IMAGE_ID
ARG PUBLIC_ORIGIN=http://127.0.0.1:3100
ARG INTERNAL_API_ORIGIN=http://api:3001

COPY --from=seed-store /pnpm-store /pnpm-store
COPY --from=seed-store /root/.cache/node/corepack /root/.cache/node/corepack
COPY --from=seed-store /root/.cache/pnpm /root/.cache/pnpm

WORKDIR /refresh-workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN corepack pnpm install --store-dir=/pnpm-store --offline --frozen-lockfile
COPY apps/web apps/web
COPY packages/contracts packages/contracts
ENV NEXT_TELEMETRY_DISABLED=1
ENV PUBLIC_ORIGIN=${PUBLIC_ORIGIN}
ENV INTERNAL_API_ORIGIN=${INTERNAL_API_ORIGIN}
RUN corepack pnpm --filter @blog-x/web build

LABEL org.opencontainers.image.revision=${REFRESH_REVISION} \
  io.blog-x.lockfile-sha256=${LOCKFILE_SHA256} \
  io.blog-x.seed-image-id=${SEED_IMAGE_ID} \
  io.blog-x.application=web \
  io.blog-x.public-origin=${PUBLIC_ORIGIN} \
  io.blog-x.refresh-kind=v1.1-offline-local-delivery

EXPOSE 3100
CMD ["corepack", "pnpm", "--filter", "@blog-x/web", "exec", "next", "start", "-H", "0.0.0.0", "-p", "3100"]
