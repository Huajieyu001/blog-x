{
  "name": "@blog-x/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build .",
    "start": "NODE_ENV=production node server.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:e2e": "cd ../.. && playwright test apps/web/e2e/walking-skeleton.spec.ts --workers=1",
    "test:e2e:auth": "cd ../.. && playwright test apps/web/e2e/auth-session.spec.ts --workers=1"
  },
  "dependencies": {
    "@blog-x/contracts": "workspace:*",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2"
  }
}
