{
  "name": "@blog-x/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/app.ts",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "tsx --test --test-reporter=tap test/markdown-renderer.test.ts test/security-hardening.test.ts",
    "db:generate:check": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/app.ts migrate",
    "db:seed": "tsx src/app.ts seed",
    "db:schema:verify": "tsx src/app.ts schema:verify",
    "publish:due": "tsx src/app.ts publish-due",
    "cleanup:views": "tsx src/app.ts cleanup-views"
  },
  "dependencies": {
    "@blog-x/contracts": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.0",
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.2",
    "pg": "8.22.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.3",
    "shiki": "4.4.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.4",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.7",
    "typescript": "7.0.2"
  }
}
