[Unit]
Description=Blog X publish due scheduled articles
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/blog-x
ExecStart=/opt/blog-x/deploy/secondary/publish-due.sh
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/run/docker.sock
