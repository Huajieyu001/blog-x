[Unit]
Description=Blog X publish due scheduled articles
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/blog-x
StateDirectory=blog-x/ops-results
ExecStart=/usr/bin/node /opt/blog-x/scripts/ops/run-secondary-job.mjs publish-due --results-root=/var/lib/blog-x/ops-results
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/run/docker.sock
