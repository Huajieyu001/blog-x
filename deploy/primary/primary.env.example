# Copy to /etc/blog-x/primary.env, fill values on the primary, then chmod 0600 it.
# This file is deliberately not a runnable environment file and contains no secrets.
PUBLIC_ORIGIN=https://huajieyu001.top
SECONDARY_SSH_HOST=replace-with-private-or-approved-secondary-host
SECONDARY_SSH_PORT=22
SECONDARY_SSH_USER=blog-x-tunnel
SSH_KEY_PATH=/etc/blog-x/ssh/secondary-tunnel.key
KNOWN_HOSTS_PATH=/etc/blog-x/ssh/known_hosts
TUNNEL_PORT=3001
WEB_PORT=3100
# Generate a 32-byte-or-longer ingress value on the host; do not commit its value.
BLOG_X_INGRESS_AUTH_SECRET=replace-with-host-generated-secret
