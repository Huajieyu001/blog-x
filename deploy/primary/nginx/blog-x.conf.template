server {
    listen 80;
    listen [::]:80;
    server_name huajieyu001.top;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name huajieyu001.top;

    ssl_certificate /etc/letsencrypt/live/huajieyu001.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/huajieyu001.top/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    server_tokens off;
    client_max_body_size 6m;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Blog-X-Client-IP $remote_addr;
        proxy_set_header X-Blog-X-Ingress-Auth __BLOG_X_INGRESS_AUTH_SECRET__;
        proxy_set_header Connection "";
        proxy_buffering off;
    }
}
